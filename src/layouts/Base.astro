---
// Port of templates/base.html (desktop variant).
import type { App } from '../data/apps';
import { getLocale, DEFAULT_LOCALE, localizedPath } from '../i18n/config';
interface Props {
  title?: string;
  wholetitle?: string;
  me?: App | null;
  bodystyle?: string;
  mobile?: boolean;       // iPhone variant: emit mobile-only meta + orientation script
  deviceClass?: string;   // value of top.device (device.classes); 'baseline' on desktop
  // --- i18n. lang drives <html lang> + og:locale; metaKeywords overrides the
  // app's English keywords on a translated page; alternates emits hreflang links. ---
  lang?: string;
  metaKeywords?: string;
  alternates?: Record<string, string>; // locale code -> root-relative path
  appFeatureList?: string[];           // localized featureList for the SoftwareApplication schema
  // --- SEO (additive; see AGENTS.md "SEO layer"). None of these affect rendering. ---
  description?: string;   // og/twitter + meta description (falls back to me.mdesc, then site default)
  ogImage?: string;       // social preview image (root-relative or absolute)
  ogType?: string;        // Open Graph type; default 'website'
  jsonLd?: object | object[]; // extra JSON-LD (e.g. Organization/WebSite on home)
}
const {
  title = '', wholetitle, me = null, bodystyle = '', mobile = false, deviceClass = 'baseline',
  lang = DEFAULT_LOCALE, metaKeywords, alternates, appFeatureList,
  description, ogImage, ogType, jsonLd,
} = Astro.props;
const loc = getLocale(lang);
// Matches Django `{% if me != None and me.id != None %}` — '' is not None, so an
// app with an empty id (e.g. pme) still renders the meta block.
const showMe = me != null && me.id != null;
const fullTitle = wholetitle ?? `${title} - EUMLab `;

// --- SEO layer (Open Graph / Twitter / canonical / JSON-LD) -------------------
// Visually inert: the verify harness's <head> diff only checks title/meta/link.
// These additions (meta og:*/twitter:*, per-page canonical, ld+json scripts) are
// declared intentional in AGENTS.md and tolerated by verify/run.mjs's diffHead.
const SITE = 'https://eumlab.com';
// Self-referential canonical per page (the legacy site wrongly pointed every page
// at the homepage). The UA-served mobile home (/m/) consolidates onto the desktop /.
const canonicalUrl = mobile ? SITE + '/' : SITE + Astro.url.pathname;
const ogTitle = (wholetitle ?? `${title} - EUMLab`).trim();
const SITE_DESC = 'EUMLab makes award-winning music apps for iPhone and iPad — including Pro Metronome, insTuner, Guitar Master and more — to help you practice, learn and perform.';
const ogDesc = (description ?? (showMe ? (me!.mdesc || me!.desc) : '')) || SITE_DESC;
const defaultImg = showMe ? `/assets/images/icons/512/${me!.icon}` : '/assets/images/logo-home.png';
const ogImg = ogImage ?? defaultImg;
const ogImageAbs = ogImg.startsWith('http') ? ogImg : SITE + ogImg;
const ogTypeFinal = ogType ?? 'website';

// hreflang alternates (visually inert; head-only — verify/run.mjs allows extra
// `alternate` links). Emitted only when a page declares its localized variants;
// x-default points at the English (default-locale) URL.
const toAbs = (p: string) => (p.startsWith('http') ? p : SITE + p);
const altEntries = alternates
  ? Object.entries(alternates).map(([code, p]) => ({ hreflang: getLocale(code).htmlLang, href: toAbs(p) }))
  : [];
const xDefaultHref = alternates && alternates[DEFAULT_LOCALE] ? toAbs(alternates[DEFAULT_LOCALE]) : null;

// JSON-LD: a SoftwareApplication for an app's own landing page (data-driven from
// apps.ts) + any page-supplied schema (Organization/WebSite, etc.). Gated to the
// app's canonical route *for the current locale* so the localized landing pages
// (/de/pro-metronome/ …) also emit it, while shared sub-pages stay unlabeled.
const isAppLanding = showMe && Astro.url.pathname === localizedPath(lang, me!.href);
const appSchema = isAppLanding ? {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': canonicalUrl + '#app',
  name: me!.name,
  inLanguage: loc.htmlLang,
  // Pro Metronome ships on iOS + Android; the other apps are iOS-only.
  operatingSystem: me!.mid === 'pm' ? 'iOS, Android' : 'iOS',
  applicationCategory: 'MultimediaApplication',
  ...(me!.mid === 'pm' ? { applicationSubCategory: 'Metronome' } : {}),
  description: description || me!.mdesc || me!.desc || '',
  url: canonicalUrl,
  image: ogImageAbs,
  // Store links + free offer only for shipping App Store apps (id set); the
  // education page (empty id, paid volume licensing) gets neither.
  ...(me!.id ? {
    installUrl: me!.storeurl,
    downloadUrl: me!.storeurl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  } : {}),
  author: { '@type': 'Organization', name: 'EUMLab', url: SITE + '/' },
  publisher: { '@type': 'Organization', name: 'Polybeat PTE.LTD.', url: SITE + '/' },
  // featureList is passed in already-localized (from the page's i18n strings).
  ...(me!.mid === 'pm' && appFeatureList && appFeatureList.length ? { featureList: appFeatureList } : {}),
} : null;
const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allJsonLd = [appSchema, ...extraJsonLd].filter(Boolean);
const ldStr = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang={loc.htmlLang}>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="rating" content="general" />
{showMe && (
  <>
    <meta name="keywords" content={metaKeywords ?? me!.kw ?? ''}>
    <meta name="description" content={description ?? me!.mdesc ?? ''}>
    <meta name="apple-itunes-app" content={`app-id=${me!.id}`}>
    <meta name="twitter:card" content="app">
    {me!.iphone && <meta name="twitter:app:id:iphone" content={`id${me!.id}`}>}
    {me!.iPad && <meta name="twitter:app:id:ipad" content={`id${me!.id}`}>}
    {me!.aurl !== '' && (
      <>
        <meta name="twitter:app:url:iphone" content={`${me!.aurl}://start`}/>
        <meta name="twitter:app:url:ipad" content={`${me!.aurl}://start`}/>
      </>
    )}
  </>
)}
{mobile && (
  <>
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
	<meta name="viewport" content="user-scalable=1;">
  </>
)}

    <slot name="meta" />

    <title>{fullTitle}</title>

    <link rel="index" title="EUMLab - Music APPs on iPhone iPad" href="http://eumlab.com/">
    <link rel="canonical" href={canonicalUrl}>
    {altEntries.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href}>
    ))}
    {xDefaultHref && <link rel="alternate" hreflang="x-default" href={xDefaultHref}>}
    <link rel="apple-touch-icon" sizes="57x57" href="/assets/favicon/apple-touch-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/assets/favicon/apple-touch-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/assets/favicon/apple-touch-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/assets/favicon/apple-touch-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/assets/favicon/apple-touch-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/assets/favicon/apple-touch-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/assets/favicon/apple-touch-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/assets/favicon/apple-touch-icon-152x152.png">
    <meta name="apple-mobile-web-app-title" content="EUMLab">
    <link rel="icon" type="image/png" href="/assets/favicon/favicon-196x196.png" sizes="196x196">
    <link rel="icon" type="image/png" href="/assets/favicon/favicon-160x160.png" sizes="160x160">
    <link rel="icon" type="image/png" href="/assets/favicon/favicon-96x96.png" sizes="96x96">
    <link rel="icon" type="image/png" href="/assets/favicon/favicon-16x16.png?v=2" sizes="16x16">
    <link rel="icon" type="image/png" href="/assets/favicon/favicon-32x32.png" sizes="32x32">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="msapplication-TileImage" content="/assets/favicon/mstile-144x144.png">
    <meta name="application-name" content="EUMLab">

    <slot name="basestyle"><link href="/assets/styles/style.css" rel="stylesheet" /></slot>

    <slot name="style" />

<!--[if IE]>
<link rel="stylesheet" type="text/css" href="/assets/styles/ie-fix.css"/>
<![endif]-->

<!--  -->
    <!--[if gte IE 9]>
    <style type="text/css">
        .gradient {
           filter: none;
        }
    </style>
    <![endif]-->

    <!-- SEO: Open Graph + Twitter (social/AI link previews). Visually inert. -->
    <meta property="og:type" content={ogTypeFinal} />
    <meta property="og:site_name" content="EUMLab" />
    <meta property="og:locale" content={loc.ogLocale} />
    {alternates && Object.keys(alternates).filter((c) => c !== lang).map((c) => (
      <meta property="og:locale:alternate" content={getLocale(c).ogLocale} />
    ))}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- SEO: JSON-LD structured data (schema.org). Not collected by the head diff. -->
    {allJsonLd.map((o) => (
      <script type="application/ld+json" is:inline set:html={ldStr(o)} />
    ))}

</head>
<body class={`${bodystyle} `}>
    <!--[if lt IE 8]>
    <div class="fuck-ie">
        <span class="face">:(</span>Your browser is too old. Please use <a href="http://www.google.com/chrome" target="_blank">Google Chrome</a> or <a href="http://windows.microsoft.com/zh-CN/internet-explorer/products/ie/home" target="_blank">update your IE browser</a>
    </div>
    <![endif]-->
    <slot />
    <script type="application/javascript" is:inline set:html={`
        top.device = {};
        top.device = "${deviceClass}";
    `}></script>
    <script src="/assets/scripts/jquery-1.11.1.min.js" is:inline></script>
    <script src="/assets/scripts/eum.js" is:inline></script>
    <script type="text/javascript" src="//use.typekit.net/agm3gqh.js" is:inline></script>
    <script type="text/javascript" is:inline>try{Typekit.load();}catch(e){}</script>
{mobile && (
    <script is:inline set:html={`
            $(window).on('load orientationchange', function() {
                /*
                // home page height is not enough
                if ($('.pg-home').length) {
                    var container = $('html, body, .container');

                    if (window.innerWidth > window.innerHeight) {
                        container.height($(window).height() + 124);
                    } else {
                        container.height($(window).height());
                    }
                }

                setTimeout(function() {
                    window.scrollTo(0, 1);
                }, 0);
                */
            });
        `}></script>
)}

    <slot name="script" />

<script is:inline>
  (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
  })(window,document,'script','//www.google-analytics.com/analytics.js','ga');

  ga('create', 'UA-389402-11', 'auto');
  ga('send', 'pageview');

</script>


</body>
</html>
