---
// Port of templates/imprint.html (route: /imprint/ )
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { appsMenu } from '../../data/apps';
---
<Base title="Imprint" bodystyle="">
  <Fragment slot="style">
    <link href="/assets/styles/imprint.css" rel="stylesheet" />
  </Fragment>

    <Nav products={appsMenu} addstyle="fixontop" />

    <div class="imprint-header">
    <img src="/assets/images/imprint/imprint.png" />
    <div class="slogan-container">
        <h1><em>Imprint</em></h1>
    </div>
    </div>

    <div class="imprint-section-container">
    <h2><em>EUMLab</em><br/>Polybeat PTE.LTD.</h2>
    <p>8 Kaki Bukit Avenue 4, #08-32,<br/>
Premier @ Kaki Bukit,<br/>
Singapore 415875</p>

    <h2>Management Board</h2>
    <p>Yixiang, XIAO <br/>
    Ming, ZHONG<br/>
    Yuan, ZHOU</p>


    <h2>Contact</h2>
    <p><a href="mailto:team+imprint@eumlab.com">team+imprint@eumlab.com</a></p>

    </div>

    <div class="divbreaker bottom-divbreaker"></div>
    <Footer />
    <div class="clearfix"></div>
</Base>
