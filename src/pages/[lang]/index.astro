---
// Localized home — /de/, /fr/, /es/, /zh/, /ja/.
import Home from '../../components/pages/Home.astro';
import { NON_DEFAULT_LOCALES } from '../../i18n/config';
export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
---
<Home lang={lang} />
