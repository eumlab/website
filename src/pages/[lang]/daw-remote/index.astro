---
import DawRemote from '../../../components/pages/DawRemote.astro';
import { NON_DEFAULT_LOCALES } from '../../../i18n/config';
export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
---
<DawRemote lang={lang} />
