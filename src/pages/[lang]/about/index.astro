---
// Localized About — /de/about/, /fr/about/, /es/about/, /zh/about/, /ja/about/.
import About from '../../../components/pages/About.astro';
import { NON_DEFAULT_LOCALES } from '../../../i18n/config';
export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
---
<About lang={lang} />
