---
// Localized Pro Metronome support — /de|fr|es|zh|ja/support/.
import Support from '../../../components/pages/Support.astro';
import { NON_DEFAULT_LOCALES } from '../../../i18n/config';
export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
---
<Support lang={lang} />
