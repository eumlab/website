---
// Port of templates/drum-tuner.html (route: /drum-tuner/ )
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { appsMenu } from '../../data/apps';
---
<Base title="Drum Tuner" bodystyle="darktheme ">
  <Fragment slot="meta">
    <meta name="apple-itunes-app" content="app-id=834487922">
  </Fragment>

  <Fragment slot="style">
    <link href="/assets/styles/drum-tuner.css" rel="stylesheet" />
  </Fragment>

  <Fragment slot="script">
    <script src="/assets/scripts/jquery.threesixty.js" is:inline></script>
    <script src="/assets/scripts/guitar-toolkit.js" is:inline></script>
  </Fragment>

<Nav products={appsMenu} />
<div class="container pg-drumtuner">
<div class="section section-3">
        <div class="center">
            <div class="intro">
                <h3 class="title">Coming Soon</h3>
            </div>
            </div>
        </div>
    </div>
    </div>
    <Footer />
</Base>
