---
// Port of templates/ukechords.html (route: /ukechords/ )
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { applist, appsMenu } from '../../data/apps';
const me = applist.ukechords;
---
<Base title="UkeChords" me={me} bodystyle="darktheme ">
  <Fragment slot="style">
    <link href="/assets/styles/ukechords.css" rel="stylesheet" />
  </Fragment>

  <Fragment slot="script">
    <script src="/assets/scripts/ukechords.js" is:inline></script>
  </Fragment>

<Nav products={appsMenu} addstyle="glow" />

    <div class="ukechords-container">
        <div class="iphone">
            <div class="cd-product-wrapper">
                <div id="showpic2" class="cd-single-point">
                    <a class="cd-img-replace" href="javascript:void(0);"></a>
                </div>

                <div id="back" class="cd-single-point">
                    <a class="cd-img-replace" href="javascript:void(0);"></a>
                </div>



                <div id="cc" class="cd-single-point pall">
                    <a class="cd-img-replace" fdata="uc_c"  href="javascript:void(0);"></a>
                </div>

                <div id="cg" class="cd-single-point pall">
                    <a class="cd-img-replace" fdata="uc_g"  href="javascript:void(0);"></a>
                </div>

                <div id="cf"  class="cd-single-point pall">
                    <a class="cd-img-replace" fdata="uc_f" href="javascript:void(0);"></a>
                </div>

                <div id="cam" class="cd-single-point pall">
                    <a class="cd-img-replace" fdata="uc_am" href="javascript:void(0);"></a>
                </div>


            </div>
        </div>

        <div class="right">
            <h1 id="appname">UkeChords</h1>
            <h2>Learn uke chords with<br/>real fingering positions</h2>
            <a href={me.storeurl} target="_blank" class="appstore-icon">Download UkeChords on the App Store</a>

        </div>
    </div>

</Base>
