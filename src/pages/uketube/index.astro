---
// Port of templates/uketube.html (route: /uketube/ )
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { applist, appsMenu } from '../../data/apps';
const me = applist.uketube;
---
<Base title="UkeTube" me={me} bodystyle="darktheme ">
  <Fragment slot="style">
    <link href="/assets/styles/bigvideo.css" rel="stylesheet" />
    <link href="/assets/styles/uketube.css" rel="stylesheet" />
  </Fragment>

  <Fragment slot="script">
    <script src="/assets/scripts/video.js" is:inline></script>
    <script src="/assets/scripts/bigvideo.js" is:inline></script>
    <script src="/assets/scripts/uketube.js" is:inline></script>
  </Fragment>

<Nav products={appsMenu} addstyle="glow" />

    <div class="uketube-container">
        <div class="iphone">

        </div>

        <div class="right">
            <h1 id="appname">UkeTube</h1>
            <h2>Learn the ukulele using YouTube.<br/>
            Watch covers, tutorials, pro tips and more.</h2>
            <a href={me.storeurl} target="_blank" class="appstore-icon">Download UkeTube on the App Store</a>

        </div>
    </div>

</Base>
