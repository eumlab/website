---
// Port of templates/drh-videos.html (route: /daw-remote-hd/videos/ )
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { appsMenu } from '../../../data/apps';
---
<Base title="Documents - DAW Remote HD" bodystyle="darktheme ">
  <Fragment slot="style">
    <link href="/assets/styles/drh.css" rel="stylesheet" />
  </Fragment>

  <Fragment slot="script">
    <script src="/assets/scripts/drh-videos.js" is:inline></script>
  </Fragment>

<Nav products={appsMenu} />
<div class="container pg-drh-videos">
    <div class="header">
        <div class="bg"></div>

        <div class="videos center">
            <iframe id="player" width="100%" height="534" src="http://www.youtube.com/embed/URfwMdpF2c4" frameborder="0" allowfullscreen=""></iframe>
            <div class="play-list tab-nav">
                <a class="play-item selected" href="#URfwMdpF2c4">Connect to MAC</a>
                <a class="play-item" href="#ABsEJdWGv3c">Connect to WIN</a>
                <a class="play-item" href="#hGXZOHuv37I">Set Logic</a>
                <a class="play-item" href="#mgheATRPJZY">Set ProTools</a>
                <a class="play-item" href="#9415zD0BnUs">Set Live</a>
            </div>
        </div>
    </div>
    </div>
    <Footer />
</Base>
