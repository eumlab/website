---
// Port of templates/_footer2.html
import { getStrings } from '../i18n';
import { localizedPath } from '../i18n/config';
interface Props { lang?: string; }
const { lang = 'en' } = Astro.props;
const t = getStrings(lang).footer;
const supportHref = localizedPath(lang, '/support/');
---
            <div class="v2-footer">
                <ul>
                    <!--Team      Press      Imprint      Contact      Support-->
                    <li><a href="/about/">{t.about}</a></li>
                    <li><a href="/imprint/">{t.imprint}</a></li>
                    <li><a href="mailto:support@eumlab.com?subject=Hi">{t.contact}</a></li>
                    <li><a href={supportHref}>{t.support}</a></li>
                </ul>
                <div class="social basic-ani">
                    <ul class="spicesocialwidget">
                      <li class="facebook">
                        <a rel="nofollow" href="https://www.facebook.com/eumlab" target="_blank" title="facebook">
                        </a>
                      </li>

                      <li class="twitter">
                        <a rel="nofollow" href="http://twitter.com/eumlab" target="_blank" title="twitter"></a>
                      </li>

                      <li class="vimeo">
                        <a rel="nofollow" href="http://www.vimeo.com/eumlab" target="_blank" title="vimeo"></a>
                      </li>

                      <li class="youtube">
                        <a rel="nofollow" href="http://www.youtube.com/eumlab" target="_blank" title="youtube"></a>
                      </li>
                    </ul>

                </div>
                <div class="copyright">
                    <p set:html={t.copyrightHtml}></p>
                </div>
            </div>
