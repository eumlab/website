---
// Pro Metronome for Education body — shared by /pro-metronome/edu/ and the
// localized /<lang>/pro-metronome/edu/ routes. Port of
// templates/pro-metronome-for-education.html; copy from the i18n dictionaries.
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { applist, appsMenu } from '../../data/apps';
import { getStrings, localizedPath, localeUrls, DEFAULT_LOCALE } from '../../i18n';

interface Props { lang?: string; }
const { lang = DEFAULT_LOCALE } = Astro.props;
const isEn = lang === DEFAULT_LOCALE;
const t = getStrings(lang);
const e = t.edu;
const me = applist.pme;
const urls = localeUrls('/pro-metronome/edu/');
const pmHref = localizedPath(lang, '/pro-metronome/');
---
<Base
  title="Pro Metronome - a music teacher's swiss-army knife"
  wholetitle={t.meta.edu.title}
  me={me}
  lang={lang}
  alternates={urls}
  description={isEn ? undefined : t.meta.edu.description}
  metaKeywords={isEn ? undefined : t.meta.edu.keywords}
  bodystyle=" "
  ogImage="/assets/images/pm2/daily-training.png">
  <Fragment slot="style">
    <link href="/assets/styles/pro-metronome-for-education.css" rel="stylesheet" />
  </Fragment>

  <Fragment slot="script">
    <script src="/assets/scripts/video.js" is:inline></script>
    <script src="/assets/scripts/bigvideo.js" is:inline></script>
    <script src="/assets/scripts/jquery.threesixty.js" is:inline></script>
    <script src="/assets/scripts/pro-metronome-for-education.js" is:inline></script>
  </Fragment>

<div class="firstpage-container">
<Nav products={appsMenu} lang={lang} langUrls={urls} />

  <div class="first">
    <div class="head">
      <div class="iphone">
      </div>
      <div class="title">
        <h1 id="appname">Pro Metronome</h1>
        <h2>{e.tagline}</h2>
      </div>
    </div>
  </div>

</div>

<div class="page-container">


  <div class="section introduction">
    <h1 class="slogan" set:html={e.introSloganHtml}></h1>
    <h2 class="slogan second" set:html={e.introSecondHtml}></h2>
  </div>


  <div class="section features">
    <div class="box">
      <div class="image">
        <img src="/assets/images/pmedu/part2-iphone.png" width="444" height="687">
      </div>
      <div class="text">
        <h1 class="slogan" set:html={e.featuresSloganHtml}></h1>
        <h2 class="slogan-desc" set:html={e.featuresDescHtml}></h2>
        <ul>
          {e.featuresList.map((item) => <li>{item}</li>)}
        </ul>
        <a id="show-poly-video" class="link-video" href="javascript:void(0);" title={e.polyLinkTitle}>{e.seeHowItWorks}</a>
      </div>
    </div>
  </div>


  <div class="section lessons dark-background">
    <div class="box">
      <div class="text">
        <h1 class="slogan" set:html={e.lessonsSloganHtml}></h1>
        <h2 class="slogan-desc" set:html={e.lessonsDescHtml}></h2>
      </div>

      <div class="image">
      </div>
    </div>
  </div>

  <div class="section counting">
  </div>

  <div id="Sync" class="section sync-beat dark-background" style="display:none">
      <h1 class="slogan">{t.proMetronome.syncSlogan}</h1>
      <div class="three-rows-container">
          <div class="left-row ">
              <h2 class="slogan-desc">{t.proMetronome.vibration}</h2>
              <img class="sync-ani" id="sync-vib" src="/assets/images/pm2/PMH@24fps/PMH_00.png" height="114" width="254">
              <div class="sync-vib"></div>
          </div>
          <div class="center-row">
              <h2 class="slogan-desc">{t.proMetronome.beats}</h2>
              <img class="sync-ani" id="sync-beat" src="/assets/images/pm2/PMH@24fps/PMH_00.png" height="114" width="254">
          </div>
          <div class="right-row">
              <h2 class="slogan-desc">{t.proMetronome.flash}</h2>
              <div class="flash-light"></div>
          </div>
      </div>
      <div class="overlayer"></div>
  </div>


  <div class="section trainer">
    <h1 class="slogan" set:html={e.trainerSloganHtml}></h1>
    <h2 class="slogan-desc" set:html={e.trainerDescHtml}></h2>
    <div class="trainer-block-container">
        <div class="note-container">
            <img src="/assets/images/pm2/trainer-notes-1.png" height="102" width="304" />
        </div>
        <div class="beats-container">
            <div id="trainer-beat-1" class="beat"></div>
            <div id="trainer-beat-2"  class="beat"></div>
            <div id="trainer-beat-3"  class="beat"></div>
            <div id="trainer-beat-4"  class="beat"></div>
        </div>
        <div class="wave-container">

        </div>
        <div id="trainer-wave" class="wave-hl-container"></div>
    </div>
    <a id="show-trainer-video" class="link-video" href="javascript:void(0);" title={e.trainerLinkTitle}>{e.seeHowItWorks}</a>

  </div>

  <div class="section download">
    <h1 class="slogan" set:html={e.downloadSloganHtml}></h1>
    <a class="basic-ani-onlyalpha appstore-icon-bottom" href={pmHref}><img src="/assets/images/icons/512/prometronome.png" height="256" width="256" ><br/>
    {e.learnMore}</a>
  </div>

  <a class="section contact" href="mailto:eum+pmedu@eumlab.com?subject=Pro Metronome EDU Inquiry">
    <h1 class="slogan">{e.contactTitle}</h1>
    <p>{e.contactDesc}</p>
  </a>


    <div class="divbreaker bottom-divbreaker"></div>

    <Footer lang={lang} />
    <div class="clearfix"></div>
</div>

<div id="popup-wrap">
    <div class="video-popup">
        <h2 id="video-title" class="video-title">{e.videoPopupTitle}</h2>
       <div id="video-container">

        </div>
    </div>
</div>

</Base>
