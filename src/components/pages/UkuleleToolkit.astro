---
// Ukulele Toolkit landing page body — shared by the English route
// (/ukulele-toolkit/) and the localized routes (/<lang>/ukulele-toolkit/).
// Markup is the verbatim port of templates/ukulele-toolkit.html; all copy comes
// from src/i18n/pages/ukulele-toolkit.ts so the English render stays byte-identical
// (it is in the verify reference set). The app name "Ukulele Toolkit" and the
// review testimonials stay in their original language.
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import Reviews from '../Reviews.astro';
import { applist, appsMenu } from '../../data/apps';
import { UKULELE_TOOLKIT } from '../../i18n/pages/ukulele-toolkit';
import { localeUrls, DEFAULT_LOCALE } from '../../i18n';

interface Props { lang?: string; }
const { lang = DEFAULT_LOCALE } = Astro.props;
const t = UKULELE_TOOLKIT[lang] ?? UKULELE_TOOLKIT[DEFAULT_LOCALE];
const isEn = lang === DEFAULT_LOCALE;
const me = applist.ut;
const urls = localeUrls('/ukulele-toolkit/');

// Icon classes for the "Other Cool Features" grid, in markup order.
const featureIcons = ['feature-tone', 'feature-tap', 'feature-lefthanded', 'feature-capo', 'feature-uke', 'feature-a4', 'feature-airplay', 'feature-audiobus', 'feature-iaa'];
---
<Base
  title="Ukulele Toolkit"
  wholetitle={t.meta.wholetitle}
  me={me}
  lang={lang}
  alternates={urls}
  description={isEn ? undefined : t.meta.description}
  metaKeywords={isEn ? undefined : t.meta.keywords}
  bodystyle=" ">
  <Fragment slot="style">
    <link href="/assets/styles/bigvideo.css" rel="stylesheet" />
    <link href="/assets/styles/ukulele-toolkit.css" rel="stylesheet" />
  </Fragment>

  <Fragment slot="script">
    <script src="/assets/scripts/video.js" is:inline></script>
    <script src="/assets/scripts/bigvideo.js" is:inline></script>
    <script src="/assets/scripts/jquery.threesixty.js" is:inline></script>
    <script src="/assets/scripts/ukulele-toolkit.js" is:inline></script>
  </Fragment>

<div class="firstpage-container">
<Nav products={appsMenu} addstyle="glow" lang={lang} langUrls={urls} />


    <div class="ut-container">
        <div class="iphone">
        </div>

        <div class="right">
            <h1 id="appname">{me.name}</h1>
            <h2>{t.heroTagline}</h2>
            <a href={me.storeurl} target="_blank" class="appstore-icon" title={`Download ${me.name}`}>{t.downloadTitle} on the App Store</a>

        </div>
    </div>
</div>

<div class="page-container">
<div class="section ">
    <h1 class="slogan" set:html={t.sloganHtml}></h1>
    <h2 class="slogan-desc">{t.sloganDesc}</h2>
    <div class="tools-4-iphones"></div>
</div>


<div class="section both-way dark-background">
    <div class="both-way-iphone"></div>

    <div class="two-row-container">
        <div id="tuner-ani-container" class="left-row">
            <div id="tuner-ani">
                <video autoplay loop preload width="640" height="472" poster="/assets/images/ut/tuner-poster.jpg" >
                     <source src="/assets/videos/ukulele-toolkit-tuner.mp4" type='video/mp4' />
                     <source src="/assets/videos/ukulele-toolkit-tuner.webm" type='video/webm' />
                     <source src="/assets/videos/ukulele-toolkit-tuner.ogv" type='video/ogg' />
                </video>
            </div>
        </div>
        <div class="right-row">
            <h1 class="slogan"><em>{t.tunerSlogan}</em></h1>
            <h2 class="slogan-desc">{t.tunerDesc}</h2>
            <!--<a id="show-tuner-video" class="link-video" href="javascript:void(0);" title="See how tuner works">See how it works</a>-->
        </div>
    </div>
</div>


<div class="section metronome">
    <h1 class="slogan" set:html={t.metronomeSloganHtml}></h1>
    <h2 class="slogan-desc" set:html={t.metronomeDescHtml}></h2>
    <a id="show-metronome-video" class="link-video" href="javascript:void(0);" title={t.metronomeLinkTitle}>{t.metronomeLink}</a>
    <img class="metronome-iphone" src="/assets/images/ut/ut-metronome.png" height="556" width="993"/>
</div>

<div class="section scale">
    <div class="two-row-container">
        <div  class="left-row">

        </div>
        <div class="right-row">
            <h1 class="slogan" set:html={t.scaleSloganHtml}></h1>
            <h2 class="slogan-desc" set:html={t.scaleDescHtml}></h2>
        </div>
    </div>

</div>



    <div class="section chords dark-background">
    <h1 class="slogan">{t.chordsSlogan}</h1>
    <h2 class="slogan-desc" set:html={t.chordsDescHtml}></h2>
    <div class="chord-chards"></div>
    <p set:html={t.chordsSupported}></p>
    <div class="overlayer"></div>
</div>


<div class="section transposer">
    <h1 class="slogan" set:html={t.transposerSloganHtml}></h1>
    <h2 class="slogan-desc" set:html={t.transposerDescHtml}></h2>

    <div class="two-row-container">
        <div class="left-row">
            <h2 class="slogan-desc" id="chords-5th-ks"></h2>
            <div class="chords-5th-container">
                <div id="chords-5th">

                </div>
                <div id="chords-5th-cover">

                </div>
            </div>
        </div>
        <div class="right-row">
                <div id="chords-5th-iphone" class="basic-ani" >
                    <!--<img src="/assets/images/ut/transpose-a.jpg" height="450" width="400" class="basic-ani" />-->
                </div>
        </div>
    </div>

</div>



<div class="section poly dark-background">
    <div class="poly-row-container">
        <div class="left-row progression-closeup">

        </div>
        <div class="right-row">
            <h1 class="slogan" set:html={t.progressionSloganHtml}></h1>
            <h2 class="slogan-desc" set:html={t.progressionDescHtml}></h2>
            <a id="show-progressions-video" class="link-video" href="javascript:void(0);" title={t.progressionLinkTitle}>{t.progressionLink}</a>
        </div>
    </div>

    <img class="supported-techs" src="/assets/images/drumloops/techs.png" height="167" width="656"/>
</div>



<div id="Features" class="section supported-techs">
    <h2 class="slogan-desc">{t.featuresHeading}</h2>

    <ul class="feature-container">
         {t.features.flatMap((f, i) => [
            <li class="feature-item">
              <h2 class={`${featureIcons[i]} feature-icon`}>{f.title}</h2>
              <p>{f.desc}</p>
            </li>,
            ' ',
          ])}
    </ul>

    <em></em>
</div>

<!--<div class="section playlist">
    <h1 class="slogan">All Features Are Available For<br/>
        <em>Tenor</em>, <em>Soprano</em> and <em>Baritone</em> Ukulele</h1>
    <h2 class="slogan-desc">You can tune your ukulele to C Tuning, D Tuning or Baritone Tuning. <br/>
    Tuner, Scales, Chords and everything will be changed for the tuning you selected.</h2>
    <img class="" src="/assets/images/ut/ukes.png" height="786" width="976"/>
</div>


<div class="section supported-techs">
    <h1 class="slogan"><em>AirPlay</em>, <em>Bluetooth</em> and <em>AudioBus</em> Supported</h1>
    <img class="" src="/assets/images/drumloops/techs.png" height="167" width="656"/>
    <em></em>
</div>
-->

<div class="divbreaker"></div>

<div class="section review">
        <Reviews reviews={me.reviews || []} heading={t.reviewsHeading} />
</div>


<div class="section download">
    <h1 class="slogan">{me.name}</h1>
    <a class="basic-ani-onlyalpha appstore-icon-bottom" href={me.storeurl} target="_blank"><img src="/assets/images/icons/512/ukuleletoolkit.png" height="256" width="256" />
    <br />
    </a>
        <p><Fragment set:html={t.downloadAvailHtml} />{me.pl && <a class="get-presskit" target="_blank" title={t.getPresskitTitle} href={me.pl}>{t.getPresskit}</a>}
    </p>
</div>



    <div class="divbreaker bottom-divbreaker"></div>

    <Footer lang={lang} />
    <div class="clearfix"></div>
</div>

<div id="popup-wrap">
    <div class="video-popup">
        <h2 id="video-title" class="video-title">{t.videoPopupTitle}</h2>
        <div id="video-container">

        </div>
    </div>
</div>

</Base>
