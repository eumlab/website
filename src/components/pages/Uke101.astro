---
// Uke101 landing page body — shared by the English route (/uke101/) and the
// localized routes (/<lang>/uke101/). Markup is the verbatim port of
// templates/uke101.html; all copy comes from the i18n dictionary so the English
// render stays byte-identical.
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { applist, appsMenu } from '../../data/apps';
import { localeUrls, DEFAULT_LOCALE } from '../../i18n';
import { UKE101 } from '../../i18n/pages/uke101';

interface Props { lang?: string; }
const { lang = DEFAULT_LOCALE } = Astro.props;
const isEn = lang === DEFAULT_LOCALE;
const t = UKE101[lang] ?? UKE101[DEFAULT_LOCALE];
const me = applist.uke101;
const urls = localeUrls('/uke101/');
---
<Base
  title="Uke 101"
  wholetitle={t.meta.wholetitle}
  me={me}
  lang={lang}
  alternates={urls}
  description={isEn ? undefined : t.meta.description}
  metaKeywords={isEn ? undefined : t.meta.keywords}
  bodystyle="">
  <Fragment slot="style">
    <link href="/assets/styles/uke101.css" rel="stylesheet" />
  </Fragment>

  <Fragment slot="script">
    <script src="/assets/scripts/uke101.js" is:inline></script>
  </Fragment>

<div class="firstpage-container">
    <Nav products={appsMenu} addstyle="glow" lang={lang} langUrls={urls} />

    <div class="uke101-container">
        <div class="iphone"></div>

        <div class="right">
            <h1 id="appname">Uke101</h1>
            <h2 set:html={t.heroH2Html}></h2>
            <a href={me.storeurl} target="_blank" class="appstore-icon" >{t.heroDownload}</a>
        </div>
    </div>
</div>

<div class="page-container">
    <div class="section learn-play">
        <h1 class="slogan" set:html={t.learnSloganHtml}></h1>
        <h2 class="slogan-desc" set:html={t.learnDescHtml}></h2>
        <div class="tree">
            <div class="lesson scale lesson-0 big"></div>
            <div class="lesson scale lesson-1"></div>
            <div class="lesson scale lesson-2"></div>
            <div class="lesson scale lesson-3"></div>
            <div class="lesson scale lesson-4"></div>
            <div class="lesson scale lesson-6"></div>
            <div class="lesson scale lesson-7"></div>
            <div class="lesson scale lesson-8"></div>
            <div class="lesson scale lesson-13"></div>
            <div class="lesson scale lesson-30"></div>
            <div class="lesson scale lesson-34"></div>
        </div>
    </div>

    <div class="section two-perspective">
        <h1 class="slogan" set:html={t.twoPerspectiveSloganHtml}></h1>
        <h2 class="slogan-desc" set:html={t.twoPerspectiveDescHtml}></h2>
        <div id="two-perspective-left" class="two-perspective-ani"></div>
        <div id="two-perspective-right" class="two-perspective-ani"></div>
    </div>

    <div class="section interactive-content dark-background">
        <h1 class="slogan" set:html={t.interactiveSloganHtml}></h1>
        <h2 class="slogan-desc">{t.interactiveDesc}</h2>
        <ul class="items">
            <li class="item learn-from-games">
                <h3>{t.gamesTitle}</h3>
                <p>{t.gamesDesc}</p>
            </li>
            <li class="item magic-chord-trainer">
                <h3>{t.chordTrainerTitle}</h3>
                <p>{t.chordTrainerDesc}</p>
            </li>
            <li class="item play-and-sing-it">
                <h3>{t.playSingTitle}</h3>
                <p>{t.playSingDesc}</p>
            </li>
        </ul>
    </div>

    <!--<div id="Features" class="section supported-techs">
    <h2 class="slogan-desc">Other Cool Features</h2>

    <ul class="feature-container">

        <li class="feature-item">
            <h2 class="feature-tuner feature-icon">Mini Tuner</h2>
            <p>A mini tuner built-inside</p>
        </li>
        <li class="feature-item">
            <h2 class="feature-background feature-icon">Practicing Tracks</h2>
            <p>59 tracks for practicing and learning songs</p>
        </li>
        <li class="feature-item">
            <h2 class="feature-capo feature-icon">Chords</h2>
            <p></p>
        </li>



    </ul>
</div>
<br/><br/>
<div class="divbreaker"></div>-->


    <div class="section download">
    <h1 class="slogan">{me.name}</h1>
    <a class="basic-ani-onlyalpha appstore-icon-bottom" href={me.storeurl} target="_blank"><img src="/assets/images/icons/512/uke101.png" height="256" width="256" />
    <br />
    </a>
    <p><Fragment set:html={t.downloadAvailHtml} />
    <a class="get-presskit" target="_blank" title={t.getPresskitTitle} href="/about/#subscribe">{t.getPresskit}</a>
    </p>


</div>



    <div class="divbreaker bottom-divbreaker"></div>

    <Footer lang={lang} />
    <div class="clearfix"></div>
</div>

</Base>
