---
// UkeHero landing page body — shared by the English route (/ukehero/) and the
// localized routes (/<lang>/ukehero/). Markup is the verbatim port of
// templates/ukehero.html; all copy comes from the i18n module so the English
// render stays byte-identical.
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { applist, appsMenu } from '../../data/apps';
import { localeUrls, DEFAULT_LOCALE } from '../../i18n';
import { UKEHERO } from '../../i18n/pages/ukehero';

interface Props { lang?: string; }
const { lang = DEFAULT_LOCALE } = Astro.props;
const isEn = lang === DEFAULT_LOCALE;
const t = UKEHERO[lang] ?? UKEHERO[DEFAULT_LOCALE];
const me = applist.ukehero;
const urls = localeUrls('/ukehero/');
---
<Base
  title="UkeHero"
  wholetitle={t.meta.wholetitle}
  me={me}
  lang={lang}
  alternates={urls}
  description={isEn ? undefined : t.meta.description}
  metaKeywords={isEn ? undefined : t.meta.keywords}
  bodystyle=" ">
  <Fragment slot="style">
    <link href="/assets/styles/ukehero.css" rel="stylesheet" />
  </Fragment>

  <Fragment slot="script">
    <script src="/assets/scripts/ukehero.js" is:inline></script>
  </Fragment>

<div class="firstpage-container">
    <Nav products={appsMenu} lang={lang} langUrls={urls} />

    <div class="ukehero-container">
        <div class="iphone"></div>

        <div class="right">
            <h1 id="appname">UkeHero</h1>
            <h2 set:html={t.tagline}></h2>
            <a href={me.storeurl} target="_blank" class="appstore-icon">{t.downloadAppStore}</a>
        </div>
    </div>
</div>

<div class="page-container">
    <!--<div class="section real-ukulele" >
        <h1 class="slogan">Make your iPhone looks & feel<br/>like a <em>real ukulele</em></h1>
        <h2 class="slogan-desc">Strumming, finger picking and changing chords has never been easier!</h2>
        <div class="videos"></div>
    </div>-->

    <div class="section smart-fingering dark-background">
        <div class="smart-fingering-image"></div>
        <div class="smart-fingering-shadow"></div>
        <h1 class="slogan" set:html={t.fingeringSlogan}></h1>
        <h2 class="slogan-desc" set:html={t.fingeringDesc}></h2></div>

    <div class="section smart-chords dark-background">
        <div class="smart-chords-image">
            <div class="smart-chords-lines"></div>
            <div class="slogan-wrap">
                <h1 class="slogan" set:html={t.chordsSlogan}></h1>
                <h2 class="slogan-desc" set:html={t.chordsDesc}></h2>
            </div>
        </div>
    </div>

    <div class="section own-chord dark-background">
        <h1 class="slogan">{t.ownChordSlogan}</h1>
        <h2 class="slogan-desc" set:html={t.ownChordDesc}></h2>
        <div class="own-chord-image"></div>
    </div>

    <div class="divbreaker"></div>

    <div class="section download">
        <h1 class="slogan">UkeHero</h1>
        <a class="basic-ani-onlyalpha appstore-icon-bottom" href={me.storeurl} target="_blank"><img src="/assets/images/icons/512/ukehero.png" height="256" width="256" />
        <br />
        </a>
    </div>

    <div class="divbreaker bottom-divbreaker"></div>

    <Footer lang={lang} />
    <div class="clearfix"></div>
</div>

</Base>
