---
// Pro Metronome landing page body — shared by the English route
// (/pro-metronome/) and the localized routes (/<lang>/pro-metronome/).
// Markup is the verbatim port of templates/pro-metronome2.html; all copy comes
// from the i18n dictionaries so the English render stays byte-identical.
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import Reviews from '../Reviews.astro';
import { applist, appsMenu } from '../../data/apps';
import { getStrings, localizedPath, localeUrls, DEFAULT_LOCALE } from '../../i18n';

interface Props { lang?: string; }
const { lang = DEFAULT_LOCALE } = Astro.props;
const isEn = lang === DEFAULT_LOCALE;
const t = getStrings(lang);
const pm = t.proMetronome;
const me = applist.pm;
const urls = localeUrls('/pro-metronome/');
const supportHref = localizedPath(lang, '/support/');
const eduHref = localizedPath(lang, '/pro-metronome/edu/');
const playUrl = 'https://play.google.com/store/apps/details?id=com.eumlab.android.prometronome';

// Icon classes for the "Other Cool Features" grid, in markup order.
const featureIcons = ['feature-ts', 'feature-tone', 'feature-accent', 'feature-tap', 'feature-timer', 'feature-background', 'feature-landscape', 'feature-visual', 'feature-adfree', 'feature-airplay', 'feature-audiobus', 'feature-iaa'];
---
<Base
  title="Pro Metronome"
  wholetitle={t.meta.proMetronome.title}
  me={me}
  lang={lang}
  alternates={urls}
  description={isEn ? undefined : t.meta.proMetronome.description}
  metaKeywords={isEn ? undefined : t.meta.proMetronome.keywords}
  bodystyle=" "
  ogImage="/assets/images/pm2/daily-training.png">
  <Fragment slot="style">
    <link href="/assets/styles/bigvideo.css" rel="stylesheet" />
    <link href="/assets/styles/pro-metronome2.css" rel="stylesheet" />
  </Fragment>

  <Fragment slot="script">
    <script src="/assets/scripts/video.js" is:inline></script>
    <script src="/assets/scripts/bigvideo.js" is:inline></script>
    <script src="/assets/scripts/jquery.threesixty.js" is:inline></script>
    <script src="/assets/scripts/pro-metronome2.js" is:inline></script>
  </Fragment>

<div class="firstpage-container">
<Nav products={appsMenu} addstyle="glow" lang={lang} langUrls={urls} />


    <div class="pm-container">
        <div class="iphone">
            <img class="screen-ani" style="display: none" />
        </div>

        <div class="right">
            <h1 id="appname">Pro Metronome</h1>
            <h2>{pm.tagline}</h2>
            <a href={me.storeurl} target="_blank" class="appstore-icon" title={pm.downloadAppStoreTitle}>{pm.downloadAppStore}</a>
            <a href={playUrl} target="_blank" rel="noopener" class="googleplay-text" title={pm.googlePlayTitle}>{pm.googlePlayText}</a>

        </div>
    </div>
</div>

<div class="page-container">
<div id="Intro" class="section ">
    <h1 class="slogan" set:html={pm.introSloganHtml}></h1>
    <h2 class="slogan-desc" set:html={pm.introDescHtml}></h2>
    <img class="daily-training" src="/assets/images/pm2/daily-training.png" height="791" width="1530" />
</div>


<div id="Simple-But-Powerful" class="section both-way dark-background">
    <div class="both-way-iphone"></div>
    <h1 class="slogan" set:html={pm.simpleSloganHtml}></h1>
    <div class="two-row-container">
        <div class="left-row">
            <h2 class="slogan-desc" set:html={pm.simpleLeftHtml}></h2>
            <img src="/assets/images/pm2/iphone-simple.png" height="851" width="407" />
        </div>
        <div class="right-row">
            <h2 class="slogan-desc" set:html={pm.simpleRightHtml}></h2>
            <img src="/assets/images/pm2/iphone-poly.png" height="851" width="407" />
        </div>
    </div>
</div>


<div id="Precision" class="section">
    <h1 class="slogan">{pm.precisionSlogan}</h1>
    <h2 class="slogan-desc" set:html={pm.precisionDescHtml}></h2>
    <img class="supported-techs" src="/assets/images/pm2/precise-iphone.png" height="420" width="1063"/>
</div>

<div id="Sync" class="section sync-beat dark-background">
    <h1 class="slogan">{pm.syncSlogan}</h1>
    <div class="three-rows-container">
        <div class="left-row ">
            <h2 class="slogan-desc">{pm.vibration}</h2>
            <img class="sync-ani" id="sync-vib" src="/assets/images/pm2/PMH@24fps/PMH_00.png" height="114" width="254">
            <div class="sync-vib"></div>
        </div>
        <div class="center-row">
            <h2 class="slogan-desc">{pm.beats}</h2>
            <img class="sync-ani" id="sync-beat" src="/assets/images/pm2/PMH@24fps/PMH_00.png" height="114" width="254">
        </div>
        <div class="right-row">
            <h2 class="slogan-desc">{pm.flash}</h2>
            <div class="flash-light"></div>
        </div>
    </div>
    <div class="overlayer"></div>
</div>


<div id="Rhythm-Trainer" class="section trainer">
    <h1 class="slogan" set:html={pm.trainerSloganHtml}></h1>
    <h2 class="slogan-desc" set:html={pm.trainerDescHtml}></h2>
    <div class="trainer-block-container">
        <div class="note-container">
            <img src="/assets/images/pm2/trainer-notes-1.png" height="102" width="304" />
        </div>
        <div class="beats-container">
            <div id="trainer-beat-1" class="beat"></div>
            <div id="trainer-beat-2"  class="beat"></div>
            <div id="trainer-beat-3"  class="beat"></div>
            <div id="trainer-beat-4"  class="beat"></div>
        </div>
        <div class="wave-container">

        </div>
        <div id="trainer-wave" class="wave-hl-container"></div>
    </div>
    <p set:html={pm.trainerHowHtml}></p>
    <a id="show-trainer-video" class="link-video" href="javascript:void(0);" title={pm.trainerLinkTitle}>{pm.seeHowItWorks}</a>

</div>



<div id="Polyrhythm" class="section poly dark-background">
    <div class="poly-row-container">
        <div class="left-row poly-closeup">

        </div>
        <div class="right-row">
            <h1 class="slogan" set:html={pm.polySloganHtml}></h1>
            <h2 class="slogan-desc" set:html={pm.polyDescHtml}></h2>
            <a id="show-poly-video" class="link-video" href="javascript:void(0);" title={pm.polyLinkTitle}>{pm.seeHowItWorks}</a>
        </div>
    </div>

    <img class="supported-techs" src="/assets/images/drumloops/techs.png" height="167" width="656"/>
</div>



<div id="Playlist" class="section playlist">
    <h1 class="slogan" set:html={pm.playlistSloganHtml}></h1>
    <h2 class="slogan-desc" set:html={pm.playlistDescHtml}></h2>
    <img src="/assets/images/pm2/share.png" height="560" width="785" />
</div>

<div id="Stage" class="section stage">
    <div class="stage-row-container">
        <div class="left-row ">
            <div class="stage-text-container">
            <h1 class="slogan">{pm.stageSlogan}</h1>
            <h2 class="slogan-desc">{pm.stageDesc}</h2>

            </div>
        </div>
        <div class="right-row">
            <img src="/assets/images/pm2/stage-iphone.png" >
        </div>
    </div>
</div>


<div id="Practice" class="section practice">
    <div class="practice-row-container">
        <h1 class="slogan">{pm.practiceSlogan}</h1>
        <h2 class="slogan-desc" set:html={pm.practiceDescHtml}></h2>
        <div class="left-row ">
            <h3>{pm.warmupTitle}</h3>
            <p>{pm.warmupDesc}</p>
            <img src="/assets/images/pm2/pratice-warmup.png" >
        </div>
        <div class="right-row">
            <h3>{pm.automatorTitle}</h3>
            <p>{pm.automatorDesc}</p>
            <img src="/assets/images/pm2/pratice-automator.png" >
        </div>
    </div>
</div>



<div id="Features" class="section supported-techs">
    <h2 class="slogan-desc">{pm.featuresHeading}</h2>

    <ul class="feature-container">
        {pm.features.flatMap((f, i) => [
          <li class="feature-item">
            <h2 class={`${featureIcons[i]} feature-icon`}>{f.title}</h2>
            <p set:html={f.descHtml}></p>
          </li>,
          ' ',
        ])}
    </ul>
</div>

<div class="divbreaker"></div>

<div class="section review">
        <Reviews reviews={me.reviews} heading={pm.reviewsHeading} />
</div>


<div class="section download">
    <h1 class="slogan">Pro Metronome</h1>
    <a class="basic-ani-onlyalpha appstore-icon-bottom" href={me.storeurl} target="_blank"><img src="/assets/images/icons/512/prometronome.png" height="256" width="256" />
    <br />
    </a>
    <a class="google-play-bottom" href={playUrl} target="_blank" rel="noopener" title={pm.googlePlayTitle}><img src="/assets/images/google-play-badge.png" alt={pm.googlePlayAlt} width="150" height="58" /></a>
    <p>
    <Fragment set:html={pm.downloadAvailHtml} />
   <a class="get-presskit" title={pm.needHelpTitle} href={supportHref}>{pm.needHelp}</a><br/>
   <a class="get-presskit" target="_blank" title={pm.getPresskitTitle} href={eduHref}>{pm.volumeLicensing}</a><br/>
    <a class="get-presskit" target="_blank" title={pm.getPresskitTitle} href="/about/#subscribe">{pm.getPresskit}</a>
    </p>


</div>


    <div class="divbreaker bottom-divbreaker"></div>

    <Footer lang={lang} />
    <div class="clearfix"></div>
</div>

<div id="popup-wrap">
    <div class="video-popup">
        <h2 id="video-title" class="video-title">{pm.videoPopupTitle}</h2>
        <div id="video-container">

        </div>
    </div>
</div>

<style>
  /* Hero: a small text link under the App Store button, styled like the title. */
  .pm-container .right .googleplay-text {
    display: block;
    padding-top: 16px;
    height: auto;
    color: #FFFFFF;
    font-weight: 200;
    font-size: 16px;
    opacity: 0.85;
    text-shadow: 0 0 1px rgba(0, 0, 0, 0.5);
  }
  .pm-container .right .googleplay-text:hover { opacity: 1; }

  /* Bottom download: Google Play badge on its own line, sized to match. */
  .section.download .google-play-bottom { display: block; margin: 12px auto 0; }
  .section.download .google-play-bottom img { display: block; margin: 0 auto; width: 150px; height: auto; padding-bottom: 0; }
</style>

</Base>
