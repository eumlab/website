---
// Pro Tuner landing page body — shared by the English route (/pro-tuner/) and
// the localized routes (/<lang>/pro-tuner/). Markup is the verbatim port of
// templates/pro-tuner.html; all copy comes from the i18n dictionary so the
// English render stays byte-identical.
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { applist, appsMenu } from '../../data/apps';
import { localeUrls, DEFAULT_LOCALE } from '../../i18n';
import { PRO_TUNER } from '../../i18n/pages/pro-tuner';

interface Props { lang?: string; }
const { lang = DEFAULT_LOCALE } = Astro.props;
const isEn = lang === DEFAULT_LOCALE;
const t = PRO_TUNER[lang] ?? PRO_TUNER[DEFAULT_LOCALE];
const me = applist.pt;
const urls = localeUrls('/pro-tuner/');
---
<Base
  title="Pro Tuner"
  wholetitle={t.meta.wholetitle}
  me={me}
  lang={lang}
  alternates={urls}
  description={isEn ? undefined : t.meta.description}
  metaKeywords={isEn ? undefined : t.meta.keywords}
  bodystyle="darktheme ">
  <Fragment slot="meta">
    <meta name="apple-itunes-app" content="app-id=483114184">
    <meta name="twitter:card" content="app">
    <meta name="twitter:app:id:iphone" content="id483114184">
    <meta name="twitter:app:id:ipad" content="id483114184">
  </Fragment>

  <Fragment slot="style">
    <link href="/assets/styles/pro-tuner.css" rel="stylesheet" />
  </Fragment>

  <Fragment slot="script">
    <script src="/assets/scripts/pro-tuner.js" is:inline></script>
  </Fragment>

<Nav products={appsMenu} addstyle="glow" lang={lang} langUrls={urls} />
<div class="container pg-pro-tuner">
    <div class="header">
        <div class="bg"></div>
        <div class="app">
            <div class="center">
                <h2 class="app-title">{t.appTitle}</h2>
                <a href="http://itunes.apple.com/app/id483114184?ls=1&mt=8" target="_blank" class="link-app-store" title={t.appStoreTitle}>{t.appStoreLink}</a>
                <div class="pic"></div>
            </div>
        </div>
    </div>
    <div class="section section-0">
        <div class="center">
            <div class="pic"></div>
            <div class="intro">
                <h3 class="title">{t.whatTitle}</h3>
                <p class="desc" set:html={t.whatDesc1Html}></p>
                <p class="desc" set:html={t.whatDesc2Html}></p>
                <p class="desc" set:html={t.whatDesc3Html}></p>
            </div>
        </div>
    </div>
    <div class="section section-1">
        <div class="center">
            <div class="pic"></div>
            <div class="intro">
                <h3 class="title">{t.accurateTitle}</h3>
                <p class="desc" set:html={t.accurateDescHtml}></p>
            </div>
        </div>
    </div>
    <div class="section section-2">
        <div class="center">
            <div class="pic"></div>
            <div class="intro">
                <h3 class="title">{t.proTitle}</h3>
                <p class="desc" set:html={t.proDescHtml}></p>
            </div>
        </div>
    </div>
    <div class="section section-3">
        <div class="center">
            <div class="pic"></div>
            <div class="intro">
                <h3 class="title">{t.universalTitle}</h3>
                <p class="desc">{t.universalDesc}</p>
            </div>
        </div>
    </div>
    <div class="section section-4">
        <div class="center">
            <div class="pic"></div>
            <div class="intro">
                <h3 class="title">{t.clipTitle}</h3>
                <p class="desc">{t.clipDesc}</p>
            </div>
        </div>
    </div>
    <div class="section section-5">
        <div class="center">
            <div class="intro">
                <h3 class="title">{t.featuresTitle}</h3>
                <ul class="desc">
                    {t.featuresHtml.map((f) => (<li set:html={f}></li>))}
                </ul>
            </div>
            <div class="intro">
                <h3 class="title">{t.categoryTitle}</h3>
                <p class="desc">{t.categoryDesc}</p>
            </div>
        </div>
    </div>
    <div class="section section-6">
        <div class="center">
            <div class="pic"></div>
            <a href="http://itunes.apple.com/app/id483114184?ls=1&mt=8" target="_blank" class="link-app-store" title={t.appStoreTitle}>{t.appStoreLink}</a>
        </div>
    </div>

</div>
    <Footer lang={lang} />
</Base>
