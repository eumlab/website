---
// About page body — shared by /about/ (English) and /<lang>/about/.
// Port of templates/press.html. Page prose/headings/labels come from
// src/i18n/pages/about.ts (en verbatim — about is in the verify reference set);
// the press-kit list and press-coverage items stay data-driven (press.json).
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { appsMenu } from '../../data/apps';
import press from '../../data/press.json';
import { ABOUT } from '../../i18n/pages/about';
import { localeUrls, DEFAULT_LOCALE } from '../../i18n';

interface Props { lang?: string; }
const { lang = DEFAULT_LOCALE } = Astro.props;
const isEn = lang === DEFAULT_LOCALE;
const a = ABOUT[lang] ?? ABOUT[DEFAULT_LOCALE];
const urls = localeUrls('/about/');
---
<Base
  wholetitle={a.meta.wholetitle}
  lang={lang}
  alternates={urls}
  description={isEn ? undefined : a.meta.description}>
  <Fragment slot="meta">
    <meta name="keywords" content={a.meta.keywords} />
    {!isEn && <meta name="description" content={a.meta.description} />}
  </Fragment>

  <Fragment slot="style">
    <link href="/assets/styles/press.css" rel="stylesheet" />
  </Fragment>

  <Fragment slot="script">
    <script src="/assets/scripts/press.js" is:inline></script>
  </Fragment>

    <Nav products={appsMenu} addstyle="fixontop glow" lang={lang} langUrls={urls} />

    <div class="press-header">
    <img src="/assets/images/press/about-logo.png" height="281" width="881"/>
    <div class="slogan-container">
        <h1><em>{a.aboutUs}</em></h1>
        <h2>{a.introH2}</h2>
        <p>{a.p1}</p>
        <!-- Pictures Here -->
        <p>{a.p2}</p>
        <p>{a.p3}</p>
        <p class="tip" set:html={a.tipHtml}></p>
        <p> </p>

     </div>
    </div>
    <div class="divbreaker"></div>


    {/* "Join to Our Mailing List" section hidden per request (2026-06-26). Delete this wrapper to restore.
    <div id="subscribe" class="press-section-container">

            <h2>Join to Our <em>Mailing List</em></h2>
            <!-- Begin MailChimp Signup Form -->
            <div id="mc_embed_signup">
            <form action="//eumlab.us8.list-manage.com/subscribe/post?u=190fc0a799a3c527dd4a07a70&amp;id=45b2147a69" method="post" id="mc-embedded-subscribe-form" name="mc-embedded-subscribe-form" class="validate" target="_blank" novalidate>

            <div class="mc-field-group">
                <input type="email" value="" name="EMAIL" class="textbox required email" placeholder="E-Mail" id="mce-EMAIL">
            </div>
            <div class="mc-field-group">
                <input type="text" value="" name="NAME" class="textbox required" placeholder="Name" id="mce-NAME">
            </div>
            <div class="mc-field-group">
                <input type="text" value="" name="COMPANY" class="textbox required" placeholder="Company" id="mce-COMPANY">
            </div>
            <input type="submit" value="Subscribe" name="subscribe" id="mc-embedded-subscribe" class="button">
                <div id="mce-responses" class="">
                    <div class="response" id="mce-error-response" style="display:none"></div>
                    <div class="response" id="mce-success-response" style="display:none"></div>
                </div>    <!-- real people should not fill this in and expect good things - do not remove this or risk form bot signups-->
                <div style="position: absolute; left: -5000px;"><input type="text" name="b_190fc0a799a3c527dd4a07a70_45b2147a69" tabindex="-1" value=""></div>

            </form>
            </div>

            <!--End mc_embed_signup-->

        <!--<div class="download section right">
            <h2>Get Company Press Kit</h2>
            <img src="/assets/images/press/company-press-download.png" height="205" width="163" />
            <a  href="https://www.dropbox.com/sh/f9xt3gyra3mtxgu/AACd977CjXwMQP_85QgTkl4Oa" target="_blank" class="press-download">Download</a>
        </div>
        <div class="clearfix"></div>-->
    </div>


    */}

    <div id="presskit" class="press-section-container presskits">
        <h2><em>{a.pressKits}</em></h2>
        <p set:html={a.pressKitsIntroHtml}></p>
        <ul class="kits-list">
            {press.kits.flatMap((kit) => [
                <li class="basic-ani"><img src={`/assets/images/icons/120/${kit.app.icon}`} height="60" width="60">
                    <h3>{kit.title}</h3>
                    <p class="press-desc">{kit.app.desc}</p>
                    <a class="press-sheet-download" href={kit.intro} target="_blank">{a.pressSheet}</a>
                    <a class="press-kit-download" href={kit.kit} target="_blank">{a.fullPressKit}</a>
                </li>,
                ' ',
            ])}
        </ul>
    </div>

    <div class="divbreaker"></div>

    <div class="press-section-container">
        <h2><em>{a.pressCoverage}</em></h2>
        <ul id="press-coverage" class="press-covers  stared">
            {press.covers.flatMap((cover) => [
                <li class={`${cover.stared ? '' : 'hide'} basic-ani`}><a class="cover" target="_blank" href={cover.link} title={cover.title}><article>{cover.title}</article></a>
                    <time>{cover.time}</time> <span class="publisher"><a href={cover.publisherLink} target="_blank">{cover.publisher}</a></span>
                    <p class="quo">{cover.quo}</p>
                    <img src={`/assets/images/press/covers/${cover.img}`} />
                </li>,
                ' ',
            ])}
        </ul>
        <a id="show-more" href="javascript:void(0)">{a.readAll}</a>
    </div>


    <div class="divbreaker bottom-divbreaker"></div>
    <Footer lang={lang} />
</Base>
